# RAG LangChain ChromaDB - Environment Configuration Template
# Copy this to .env and fill in your actual values

# ================================================================================
# LLM Provider Configuration
# ================================================================================
# Choose one provider: "groq", "openai", or "lamini"
LLM_PROVIDER=groq

# Groq Configuration
# Get API key from: https://console.groq.com/
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama3-8b-8192

# Alternatively, use OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-3.5-turbo

# Alternatively, use Lamini
# LLM_PROVIDER=lamini
# LLM_API_KEY=your_lamini_api_key_here
# LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# LLM Parameters
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ================================================================================
# Embedding Configuration
# ================================================================================
# Sentence Transformer model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ================================================================================
# ChromaDB Configuration
# ================================================================================
# Name for the document collection
CHROMA_COLLECTION_NAME=documents

# Directory where ChromaDB will persist data
CHROMA_PERSIST_DIR=./data/chroma

# ================================================================================
# PDF Processing Configuration
# ================================================================================
# Method for text extraction: "pdfplumber" or "pypdf"
PDF_EXTRACTION_METHOD=pdfplumber

# Size of text chunks (in characters)
PDF_CHUNK_SIZE=500

# Overlap between consecutive chunks (in characters)
PDF_CHUNK_OVERLAP=0

# ================================================================================
# Application Directories
# ================================================================================
# Directory for input PDF files
INPUT_DIR=./data/input

# Directory for output files
OUTPUT_DIR=./data/output

# ================================================================================
# Logging Configuration
# ================================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
